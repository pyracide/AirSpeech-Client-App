<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ink_preview_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fitCenter" />
        
    <!-- Smart Glasses Stream View (Initially Hidden) -->
    <ImageView
        android:id="@+id/smart_glasses_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:scaleType="fitCenter"
        android:background="#000000"
        app:layout_constraintTop_toTopOf="@id/view_finder"
        app:layout_constraintBottom_toBottomOf="@id/view_finder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Smart Glasses H.264 Texture View (Classic) -->
    <TextureView
        android:id="@+id/smart_glasses_h264_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/view_finder"
        app:layout_constraintBottom_toBottomOf="@id/view_finder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Smart Glasses H.264 RTSP View Container (for hardware transforms) -->
    <FrameLayout
        android:id="@+id/smart_glasses_rtsp_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/view_finder"
        app:layout_constraintBottom_toBottomOf="@id/view_finder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <com.alexvas.rtsp.widget.RtspSurfaceView
            android:id="@+id/smart_glasses_rtsp_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <com.google.mediapipe.examples.handlandmarker.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/view_finder"
        app:layout_constraintBottom_toBottomOf="@id/view_finder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- JIIX Debug Overlay: reconstructs exactly what MyScript received.
         Shown only when jiix_debug_mode is toggled in Settings.
         Occupies the top half of the viewport. Tap to dismiss. -->
    <com.google.mediapipe.examples.handlandmarker.JiixDebugView
        android:id="@+id/jiix_debug_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="@id/view_finder"
        app:layout_constraintBottom_toBottomOf="@id/view_finder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintHeight_percent="0.5" />


        
    <!-- Ink Visualization Area -->
    <androidx.cardview.widget.CardView
        android:id="@+id/ink_preview_container"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_margin="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        android:backgroundTint="#CC0F172A"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <com.google.mediapipe.examples.handlandmarker.InkPreviewView
            android:id="@+id/ink_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JIIX Stroke View"
            android:textSize="10sp"
            android:textColor="#8894A6"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/text_recognition_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/glass_panel_bg"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:text="Write in the air..."
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_controls_row"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/text_ngram_debug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:background="@drawable/glass_panel_bg"
        android:padding="8dp"
        android:textColor="#00FFFF"
        android:textSize="12sp"
        android:text="N-Gram Debug Info"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
        
    <TextView
        android:id="@+id/text_debug_coords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/glass_panel_bg"
        android:padding="8dp"
        android:textColor="#00FF00"
        android:textSize="14sp"
        android:text="X: 0, Y: 0"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
        
    <TextView
        android:id="@+id/text_confidence_debug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:background="@drawable/glass_panel_bg"
        android:padding="8dp"
        android:textColor="#FFFF00"
        android:textSize="14sp"
        android:text="Conf: --"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/text_llm_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/glass_panel_bg"
        android:padding="6dp"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:text="LLM: idle"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/text_confidence_debug"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/top_controls_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/glass_panel_bg"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btn_wide_angle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wide"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/glass_button_bg"
            app:backgroundTint="@null"
            android:textColor="#FFFFFF"/>
            
        <Button
            android:id="@+id/btn_drawing_mode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Draw: OFF"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/glass_button_bg"
            app:backgroundTint="@null"
            android:textColor="#FFFFFF"/>
            
        <Button
            android:id="@+id/btn_mirror_camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mirror"
            android:visibility="gone"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/glass_button_bg"
            app:backgroundTint="@null"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_reset_llm_context"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Reset LLM Context"
        android:textSize="12sp"
        android:visibility="gone"
        android:background="@drawable/glass_button_bg"
        app:backgroundTint="@null"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/ink_preview_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_baseline_settings_24"
        app:tint="#FFFFFF"
        android:background="@drawable/rounded_button_bg"
        android:contentDescription="Settings"
        app:layout_constraintBottom_toTopOf="@id/ink_preview_container"
        app:layout_constraintEnd_toEndOf="parent"/>
        
    <ImageButton
        android:id="@+id/btn_smart_glasses"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_glasses" 
        app:tint="#00AAFF"
        android:background="@drawable/rounded_button_bg"
        android:contentDescription="Smart Glasses Mode"
        app:layout_constraintBottom_toTopOf="@id/ink_preview_container"
        app:layout_constraintStart_toStartOf="parent"/>
        
    <LinearLayout
        android:id="@+id/layout_debug_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/glass_panel_bg"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_reset_llm_context"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp">
        <TextView
            android:id="@+id/text_drawing_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFBB00"
            android:textSize="12sp"
            android:text="Drawing Zone: 1" />

        <TextView
            android:id="@+id/text_udp_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EF4444"
            android:textSize="10sp"
            android:text="UDP: Idle" />

        <TextView
            android:id="@+id/text_camera_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:text="Cam FPS: --" />

        <TextView
            android:id="@+id/text_mediapipe_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:textSize="12sp"
            android:text="MP FPS: --" />

        <TextView
            android:id="@+id/text_timer_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00FFFF"
            android:textSize="12sp"
            android:text="Timer: -- ms" />

        <TextView
            android:id="@+id/text_pinch_debug"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:text="Pinch: S=--, P=--, R=--" />

        <TextView
            android:id="@+id/text_fist_clench_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:text="Fist Clench: --" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
